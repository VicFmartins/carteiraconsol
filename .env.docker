# Environment file for docker-compose local stack
# This file is safe to commit — no real secrets here.
# For production, replace these values with real credentials via AWS Secrets Manager.

# App
PROJECT_NAME=CarteiraConsol
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
AUTO_CREATE_TABLES=true

# Database — points to the postgres container
DATABASE_URL=postgresql+psycopg://carteira:carteira@postgres:5432/carteira_db

# Storage — points to the minio container (S3-compatible)
RAW_STORAGE_MODE=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://minio:9000
S3_BUCKET_NAME=carteiraconsol-raw
S3_BUCKET_PREFIX=incoming/

# Risk profile default
DEFAULT_RISK_PROFILE=moderado
