PROJECT_NAME=CarteiraConsol
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# PostgreSQL-first local development URL
# Example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/etl_db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/etl_db
# Optional SQLite fallback for tests or quick local experiments only:
# DATABASE_URL=sqlite:///./carteiraconsol_dev.db
# Optional if you already use the AWS CLI/default credential chain locally
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=us-east-1
S3_ENDPOINT_URL=
S3_USE_PATH_STYLE=false
S3_BUCKET_NAME=carteiraconsol-vi-001
S3_BUCKET_PREFIX=incoming/
DEFAULT_RISK_PROFILE=moderado
RAW_STORAGE_MODE=local
# Development convenience only. Prefer explicit migrations in shared or production environments.
AUTO_CREATE_TABLES=true
API_PREFIX=
JWT_SECRET_KEY=change-me-before-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ALERTS_ENABLED=false
ALERT_PROVIDER=noop
ALERT_SNS_TOPIC_ARN=
